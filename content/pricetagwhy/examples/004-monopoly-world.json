  ],
  "claims": [
    {
      "claim": "Lizzie Magie was granted a patent for The Landlord's Game on 5 January 1904",
      "sources": [
        3,
        4
      ]
    },
    {
      "claim": "The game was made to show how land monopoly and rent make landlords rich and tenants poor",
      "sources": [
        1,
        5
      ]
    },
    {
      "claim": "Players copied the game by hand for decades; Charles Darrow, out of work in the Depression, learned it from friends in 1932",
      "sources": [
        1,
        2
      ]
    },
    {
      "claim": "Darrow sold it as his own invention; Parker Brothers bought it in 1935 and paid him royalties",
      "sources": [
        1,
        2,
        5
      ]
    },
    {
      "claim": "Parker Brothers then bought Magie's patent for $500 and no royalties",
      "sources": [
        2,
        5
      ]
    },
    {
      "claim": "Darrow became a millionaire, the first game designer to do so",
      "sources": [
        2,
        3
      ]
    },
    {
      "claim": "Magie's role came back to light in the 1970s through Ralph Anspach's Anti-Monopoly court fight",
      "sources": [
        1,
        5
      ]
    }
  ],
