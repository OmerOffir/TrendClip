 "claims": [
  {
   "claim": "A Coke cost a nickel from 1886 until about 1959, more than 70 years",
   "sources": [
    1,
    2,
    5
   ]
  },
  {
   "claim": "The price held through wars and the Great Depression",
   "sources": [
    1,
    5
   ]
  },
  {
   "claim": "In 1899 Chattanooga lawyers Benjamin Thomas and Joseph Whitehead got the rights to bottle Coca-Cola from company president Asa Candler",
   "sources": [
    1,
    3,
    4
   ]
  },
  {
   "claim": "The bottling rights were sold for $1",
   "sources": [
    3,
    4
   ]
  },
  {
   "claim": "The 1899 contract sold the bottlers syrup at a fixed price forever",
   "sources": [
    1,
    2
   ]
  },
  {
   "claim": "Coca-Cola advertised the 5-cent price widely, including painted signs on store walls",
   "sources": [
    1,
    2
   ]
  },
  {
   "claim": "Coke's vending machines were built to take only a nickel",
   "sources": [
    1,
    2,
    5
   ]
  },
  {
   "claim": "Moving to a dime meant a 100% jump, seen as too big",
   "sources": [
    1,
    5
   ]
  },
  {
   "claim": "Coca-Cola's boss Robert Woodruff, Eisenhower's hunting friend, asked him for a 7.5-cent coin",
   "sources": [
    1,
    2
   ]
  },
  {
   "claim": "The Treasury disliked the idea and no coin was made",
   "sources": [
    1,
    2
   ]
  },
  {
   "claim": "As costs rose, prices crept up to 6, 7 or 10 cents depending on the area",
   "sources": [
    1,
    2
   ]
  },
  {
   "claim": "The last nickel Cokes disappeared around 1959",
   "sources": [
    1,
    2,
    5
   ]
  }
 ],
