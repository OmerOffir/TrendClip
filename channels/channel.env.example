# One channel's own settings and secrets. Copy to channels/<name>/channel.env (gitignored) and set
# CHANNEL=<name> in the shared .env. Anything here wins over .env, so any .env setting (TTS_VOICE,
# MUSIC_VOLUME, …) can also differ per channel. The channel's login files live next to it:
#   token_youtube.json    (dashboard -> Upload -> Connect YouTube)
#   token_instagram.json  (written when INSTAGRAM_ACCESS_TOKEN is refreshed)
#   client_secret.json    (optional: this channel's own Google OAuth client; else the shared one in the project folder)

# The handle said in the calls to action ("Sub to @handle for Part 2").
CHANNEL_HANDLE=@SideQuestLogic

# Channel report (morning summary + /stats): links or handles. Empty = skip that platform.
STATS_YOUTUBE=https://www.youtube.com/@SideQuestLogic-t6g
STATS_TIKTOK=https://www.tiktok.com/@sidequestlogic
STATS_INSTAGRAM=https://www.instagram.com/sidequestlogic/
# Instagram API access token for this account (README -> Channel report).
INSTAGRAM_ACCESS_TOKEN=

# Discord channel for this channel's morning summary and reminders.
DISCORD_CHANNEL_ID=
