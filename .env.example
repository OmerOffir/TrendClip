# Copy to .env and fill in. Never commit .env.
# This file holds what every channel shares. Each channel's own settings and secrets (handle, stats
# links, Instagram token, Discord channel) are in channels/<CHANNEL>/channel.env, next to its login
# files; see channels/channel.env.example.

# Active channel (a folder under channels/).
CHANNEL=sidequestlogic
# Where the videos go: the plan's platforms, the captions, the morning report and the Upload tab's tabs.
# TikTok has no upload API, so it is off by default; PLATFORMS=youtube,instagram,tiktok brings it back.
PLATFORMS=youtube,instagram


# Required: Google Cloud console -> APIs & Services -> Credentials -> API key (YouTube Data API v3 enabled)
YOUTUBE_API_KEY=
YT_REGIONS=US
YT_CATEGORY_ID=20
YT_MAX_RESULTS_PER_REGION=50
YT_OUTLIER_RATIO=2.0

TOP_TOPICS=10
REQUEST_TIMEOUT=15
OUTPUT_DIR=output

# Background gameplay downloads
# Optional: https://www.pexels.com/api/ -> free API key. Without it, only YouTube is used.
PEXELS_API_KEY=
# No-Copyright gameplay channels: handles (@name), channel ids (UC...) or names, comma-separated.
NCG_CHANNELS=@NoCopyrightGameplays,@OrbitalNCG,No Copyright Gameplay
# Order tried by get_background_video(): pexels and/or youtube.
BACKGROUND_SOURCES=pexels,youtube
# Clip length in seconds (0 = whole video) and landscape | portrait (prefers "Vertical" uploads).
BACKGROUND_CLIP_SECONDS=60
BACKGROUND_ORIENTATION=landscape
ASSETS_DIR=assets

# Create tab (script + voiceover + Short)
# https://aistudio.google.com/apikey -> Create API key. Gemini watches the clip and writes the script.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Dark Outliers (optional): a "script" app from https://www.reddit.com/prefs/apps gives the fetcher real
# upvotes (posts under 100 are skipped) and avoids the logged-out RSS rate limit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Dark Outliers videos (python -m modules.video_gen, or "Make the video" in the tab). Who draws the scene
# pictures: auto = the NVIDIA GPU (local, Stable Diffusion XL via diffusers, see requirements-gpu.txt) when
# it is there, else gemini (needs a key with billing: the free tier has no image quota), else placeholder.
DA_IMAGE_BACKEND=auto
DA_IMAGE_MODEL=SG161222/RealVisXL_V4.0_Lightning
DA_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# A Wikipedia story also shows the article's real photos (scene 1 and the middle scene), credited.
DA_ARCHIVE_PHOTOS=1
# The narrator (default: TTS_VOICE) and speed, the music ("folder:dramatic", "mine", "none") and its level,
# the caption highlight (yellow / cyan / green / orange) and whether the title shows for the first 3 s.
# kokoro = an open-source narration voice on the GPU (natural sentence stops, a timestamp for every word);
# edge = the gameplay channel's Edge / F5 voice (DA_TTS_RATE applies to it).
DA_TTS_ENGINE=kokoro
DA_TTS_VOICE=bm_george
DA_TTS_SPEED=0.95
DA_TTS_RATE=+10%
DA_MUSIC=folder:dramatic
DA_MUSIC_VOLUME=0.16
DA_HIGHLIGHT=orange
DA_TITLE_CARD=1
# The banner over the last 3.5 s ("·" starts a new line; add the handle once the channel exists; none = off).
DA_END_CARD=Follow for more · dark stories
# The closing line the narrator speaks after the last scene, and the red button shown from that line to the
# end (subscribe / follow / none).
DA_CTA_LINE=Follow for more dark stories.
DA_CTA_STICKER=subscribe
# Frame 0 is the thumbnail (YouTube takes it for a video uploaded through the API): a big headline over
# the middle for the first second. auto = Gemini's thumbnail_text (older scripts: the hook's first words),
# or your own words, or none.
DA_COVER=auto
# The Dark Outliers plan (tab -> Plan): upload times per day ("HH:MM,HH:MM", in TIMEZONE). With DA_AUTO_POST the
# Discord bot uploads the slot's planned video to the Dark Outliers YouTube channel at its time, as
# DA_UPLOAD_PRIVACY (private / unlisted / public), and reports in the channel's Discord channel.
DA_SLOTS=14:30,23:00
DA_AUTO_POST=1
DA_UPLOAD_PRIVACY=public
# Full automation: every day at DA_AUTO_PRODUCE_TIME the bot refreshes the bank (DA_DAILY_FETCH) and makes a
# video for every empty slot of tomorrow (and today's still 3 h away): the best story of the pillar the mix
# needs, its script, the video, a check (DA_MIN_SECONDS-DA_MAX_SECONDS long, real pictures), then the slot.
# Posted in the channel's Discord channel with a "Don't post this" button.
DA_AUTO_PRODUCE=1
DA_AUTO_PRODUCE_TIME=09:30
DA_DAILY_FETCH=1
DA_MIN_SECONDS=25
DA_MAX_SECONDS=60
# After a public upload the channel comments the script's closing question (comments are an engagement signal).
DA_FIRST_COMMENT=1
# The channel learns from its own numbers (output/darkarchives/insights.json, read from YouTube at most every
# DA_INSIGHTS_HOURS): once 5 videos are measured, every script prompt ends with what worked (DA_SCRIPT_LEARNING)
# and the pillar mix leans towards the pillar that gets the views, by up to DA_PILLAR_BIAS of its share (0 = off).
DA_SCRIPT_LEARNING=1
DA_INSIGHTS_HOURS=4
DA_PILLAR_BIAS=0.15
# Moving film grain (off: it makes the file about ten times bigger) and the final x264 preset.
DA_GRAIN=0
DA_X264_PRESET=fast
# Free Microsoft Edge voices (edge-tts); list them in the Create tab.
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+5%
# Up to 30: viral rules (18-22 s, question or loop ending, subscribe sticker instead of a spoken CTA).
SHORT_TARGET_SECONDS=22
# Background music channels (handles or channel ids). Default: NoCopyrightSounds, the official
# Audio Library channel and Chillhop Music. MUSIC_VOLUME is the music level under the voice (0-1).
MUSIC_CHANNELS=@NoCopyrightSounds,UCht8qITGkBvXKsR1Byln-wA,@ChillhopMusic
MUSIC_VOLUME=0.14
# Your own tracks sorted by story mood: <dir>/funny and <dir>/chill (<dir>/dramatic is not picked
# automatically: background music stays chill lo-fi / quirky).
# Shorts always keep MUSIC_VOLUME between 0.12 and 0.15.
MUSIC_LIBRARY_DIR=music

# Upload slots (14:30 / 23:00) and bot reminders use this IANA time zone.
TIMEZONE=Asia/Jerusalem

# Discord bot (./run.sh bot). https://discord.com/developers/applications -> New Application -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=
# Your server's id (right-click the server -> Copy Server ID; needs Developer Mode in Discord settings).
DISCORD_GUILD_ID=
# The Discord channel for the morning summary and reminders is per channel: DISCORD_CHANNEL_ID in channel.env.

# --- Two machines, one plan -------------------------------------------------------------------
# The machines talk through Discord (same DISCORD_BOT_TOKEN on both). HUB_ROLE=hub on the always-on
# machine: it keeps the plan and runs the bot. HUB_ROLE=sender on the other: its Shorts get a
# "Send to Linux" button, the hub refuses a taken upload time, and it doesn't start the bot.
# HUB_CHANNEL_ID: a private Discord channel for the transfer messages (same id on both machines;
# empty = the channel's DISCORD_CHANNEL_ID).
HUB_ROLE=sender
HUB_CHANNEL_ID=
# Optional: only these user ids may use the bot (comma-separated). Empty: everyone on the server.
DISCORD_ALLOWED_USERS=
# Daily plan summary time, and how many minutes before 14:30 / 23:00 the bot sends the video (0 = off).
DISCORD_MORNING_TIME=10:00
DISCORD_REMINDER_MINUTES=30
# At 14:30 / 23:00 the bot posts the planned Short on YouTube and Instagram by itself and says so here.
AUTO_POST=true
# Emergency: an hour before 14:30 / 23:00 with nothing planned, make a random video (random type, GTA V or Minecraft gameplay)
# and plan it there, so the slot still goes out.
EMERGENCY_VIDEO=true
# "Pick for me" and the emergency videos choose the kind, game and story length by the channel's own
# numbers (Insights): the last AUTO_PICK_DAYS days, drawing at random AUTO_PICK_EXPLORE (0-1) of the time
# so untried ideas still get a turn. AUTO_PICK=false keeps the fixed weights (math most often).
AUTO_PICK=true
AUTO_PICK_EXPLORE=0.2
AUTO_PICK_DAYS=60
# The game pick also reads the Trends pipeline (YT_REGIONS; a few quota units, at most twice a day): games
# the channel already published get a boost when they trend now, and the exploration share goes to games
# never tried, in order of their YouTube momentum, so a new game is tried when people are watching it.
AUTO_PICK_TRENDS=true
# The kinds the picker may choose: story, math, riddle, trivia, paradox, movie (default: all). A quiz-only
# channel sets AUTO_PICK_KINDS=math,riddle,trivia,paradox,movie in its channel.env.
AUTO_PICK_KINDS=story,math,riddle,trivia,paradox,movie


# Every new script prompt ends with the channel's own lessons from Insights: the hooks that kept viewers,
# the styles that lost them, the length that works, the endings that drew comments, the titles used lately.
SCRIPT_LEARNING=true
# Full automation: at AUTO_PRODUCE_TIME the bot makes a video for every empty slot (tomorrow's, and today's
# when 3+ hours away) by the channel's numbers, plans it and posts it to Discord; it goes out by itself
# unless "Don't post this" is pressed. AUTO_PRODUCE=false: only the emergency video an hour before.
AUTO_PRODUCE=true
AUTO_PRODUCE_TIME=10:15



# The leaderboard picture + a ready caption to post on YouTube, sent to Discord daily (empty = off).
DISCORD_LEADERBOARD_TIME=13:30
# Reply on YouTube to every fan's comment (not spam / links / rude; quizzes after 24 h), 2 min apart.
YOUTUBE_AUTO_REPLIES=true
# At most this many replies a day (each costs 50 of the 10,000 daily YouTube API units).
YOUTUBE_REPLY_DAILY_MAX=100
# Read the comments this often for new ones to reply to (0 = only the morning read and /replies).
YOUTUBE_REPLY_CHECK_HOURS=3
# Reply on Instagram too: one reply per fan per Reel; about half invite them to the YouTube leaderboard.
INSTAGRAM_AUTO_REPLIES=true
INSTAGRAM_REPLY_DAILY_MAX=50
# How the Instagram replies name the YouTube channel (no links: Instagram flags those as spam).
INSTAGRAM_YOUTUBE_NAME=SideQuest Logic


# --- After Market (the third channel: a trader's brief before the open and at the close; modules/am_*.py) ---
# Free sources with no key: Yahoo Finance quotes, the Nasdaq earnings calendar, ForexFactory, CoinGecko,
# CNBC / Google News RSS. The movers are the watchlist + whoever reports + Yahoo's trending list.
AM_WATCHLIST=TSLA,NVDA,AAPL,MSFT,AMZN,META,GOOGL,AMD,NFLX,PLTR
# The narration: kokoro on the GPU (AM_TTS_VOICE, e.g. am_michael / am_adam / bf_emma; word timings), f5 (the GPU
# voice that copies a reference clip: record an energetic reader as a 10 s wav, put its transcript in a .txt
# next to it and point AM_TTS_REF at the wav), or edge (the gameplay voice).
AM_TTS_ENGINE=kokoro
AM_TTS_VOICE=am_michael
AM_TTS_SPEED=1.15
# AM_TTS_REF=trendclip/voices/energetic.wav
# Broll pictures (the "broll" scenes) come from the same backends as DA_IMAGE_BACKEND; charts are drawn locally.
# The ticker and crypto cards draw their line as the scene starts (AM_ANIMATE_CHARTS=0 for stills); a whoosh at
# every cut and a tick as a chart draws, synthesised in assets/sfx (AM_SFX_VOLUME=0 turns them off).
AM_ANIMATE_CHARTS=1
AM_SFX_VOLUME=0.5
# Music: drop deep electronic beds (mp3) in music/electronic/; until there are some, music/chill plays.
AM_MUSIC=folder:electronic
AM_MUSIC_VOLUME=0.20
AM_HIGHLIGHT=yellow
AM_END_CARD=Follow for the next session
AM_COVER=auto
# AM_CTA_LINE=Follow for the close.     (spoken last; default depends on the slot; none = off)
# The channel runs by itself from the Discord bot (channels/aftermarket/channel.env: CHANNEL_HANDLE and the
# DISCORD_CHANNEL_ID it reports in; its YouTube login from the After Market tab). AM_SLOTS, in TIMEZONE: the
# pre-market brief (08:00 New York) and the close (16:00 New York); the job before the open starts AM_LEAD
# minutes early so the video is up at the slot, the close job starts at its time so it has the closing prints.
# A day with no session (weekends, NYSE holidays) gets one video at the first slot: Saturday the week in
# review, Sunday the week ahead. AM_AUTO_POST=0 makes the videos without uploading them.
AM_SLOTS=15:00,23:00
AM_LEAD=20
AM_AUTO_POST=1
AM_UPLOAD_PRIVACY=public
# YouTube category: 25 News & Politics (default) or 27 Education.
AM_CATEGORY=25
